# Standard Product automation environment template.
# Do not commit real passwords, cookies, tokens, or copied browser sessions.

TA_ENV=sit
TA_BASE_URL=https://anticket.lengliwh.com
TA_ANTANK_URL=https://anticket.lengliwh.com

# Set these from the sensitive operational reference only at runtime.
TA_USER1_USERNAME=
TA_USER1_PASSWORD=

# Real API mutation guard. Keep disabled unless the Test Manager explicitly
# approves running write APIs against the named test data.
TA_ALLOW_BATCH_MUTATION=0

# Optional: use OS proxy settings for requests.Session.
TA_USE_SYSTEM_PROXY=0
