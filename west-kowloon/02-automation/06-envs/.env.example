TA_ENV=sit
TA_BASE_URL=https://httpbin.org
TA_ANTANK_URL=https://anticket.lengliwh.com
TA_ARTIFACTS_DIR=07-artifacts

# Observability Stack (optional, used by dashboard + perf tests).
PROMETHEUS_URL=http://localhost:9090
GRAFANA_URL=http://localhost:3000
GRAFANA_API_KEY=
GRAFANA_DASHBOARD_UID=locust-perf
LOKI_URL=http://localhost:3100

# ZenTao integration (optional, used by QA dashboard).
# Prefer account/password so the backend can own token refresh. A static
# ZENTAO_API_V2_TOKEN is only a fallback and may expire or be invalidated.
ZENTAO_ACCOUNT=your-zentao-account
ZENTAO_PASSWORD=your-zentao-password
ZENTAO_SESSION_COOKIE=
ZENTAO_API_V2_TOKEN=

# Website end-user credentials — referenced by config/users.yml via
# ${TA_WEBSITE_USERNAME} / ${TA_WEBSITE_PASSWORD} placeholders.
# Copy this file to .env.<env> and fill the real values; never commit those.
TA_USER1_USERNAME=your-admin-user
TA_USER1_PASSWORD=your-admin-password
TA_USER2_USERNAME=your-editor-user
TA_USER2_PASSWORD=your-editor-password
TA_USER3_USERNAME=your-viewer-user
TA_USER3_PASSWORD=your-viewer-password
TA_WEBSITE_USERNAME=your-test-account@example.com
TA_WEBSITE_PASSWORD=your-password-here
